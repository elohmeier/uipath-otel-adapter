UIPATH_URL=https://orchestrator.example.com
UIPATH_CLIENT_ID=replace-me
UIPATH_CLIENT_SECRET=replace-me
UIPATH_INSTALLATION=my-installation
UIPATH_TENANT=tenant-a
UIPATH_ENVIRONMENT=production
# UIPATH_FOLDER_IDS=101,102
# UIPATH_DIAL_ADDRESS=host.docker.internal:18443
# UIPATH_CA_FILE=/run/private/ca.pem
UIPATH_TLS_INSECURE=false
POLL_INTERVAL=60s
INITIAL_LOOKBACK=24h
LOG_INITIAL_LOOKBACK=1h
LOG_OVERLAP=5m
COLLECT_LOGS=true
INCLUDE_LOG_MESSAGES=false
# Opt in to the Development log.record.uid convention for stable log identity.
INCLUDE_LOG_RECORD_UID=false
COLLECT_QUEUES=false
COLLECT_RUNTIMES=false
COLLECT_JOB_SNAPSHOTS=false
# Account identities are only fetched/exported with this explicit opt-in.
INCLUDE_ROBOT_USERNAMES=false

# Rolling queue outcome window; active backlog is collected regardless of age.
QUEUE_HISTORY_LOOKBACK=24h
