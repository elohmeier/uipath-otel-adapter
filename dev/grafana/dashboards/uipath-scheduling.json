{
  "uid": "uipath-scheduling",
  "title": "UiPath host occupancy",
  "tags": [
    "uipath",
    "opentelemetry"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "source",
        "label": "Source",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "uipath-metrics"
        },
        "query": {
          "query": "query_result(label_join(max by(instance,uipath_installation,uipath_tenant_id,deployment_environment_name)(target_info{job=\"uipath/uipath-orchestrator\"}),\"source_label\",\" / \",\"uipath_installation\",\"uipath_tenant_id\",\"deployment_environment_name\"))",
          "refId": "source"
        },
        "regex": "/instance=\"(?<value>[^\"]+)\".*source_label=\"(?<text>[^\"]+)\"/",
        "multi": false,
        "includeAll": false,
        "refresh": 2
      },
      {
        "name": "folder",
        "label": "Job folder",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "uipath-metrics"
        },
        "query": {
          "query": "query_result(uipath_folder_info{instance=\"$source\"})",
          "refId": "folder"
        },
        "regex": "/uipath_folder_id=\"(?<value>[^\"]+)\".*uipath_folder_name=\"(?<text>[^\"]+)\"/",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "runtime",
        "label": "Runtime type",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "uipath-metrics"
        },
        "query": {
          "query": "label_values(uipath_runtime_status{instance=\"$source\"}, uipath_runtime_type)",
          "refId": "runtime"
        },
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {
          "text": "Unattended",
          "value": "Unattended"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Host occupancy and executions",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**Host capacity covers the whole source**, including work outside the selected folder. Job tables show the latest unexpired, complete snapshot; an empty table is only known-empty when **Snapshot status = complete** and its job count is zero. No snapshot means unknown. Scheduling and per-job queue totals are not collected."
      }
    },
    {
      "id": 2,
      "title": "Runtime collection",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "uipath-metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(uipath_collector_runtimes_status{instance=\"$source\"} != 1) or (uipath_collector_runtimes_status{instance=\"$source\"} and on(instance) ((uipath_collector_runtimes_status{instance=\"$source\"} == 1) and on(instance) (time() - uipath_collector_runtimes_last_success_time_seconds{instance=\"$source\"} < on(instance) uipath_collector_freshness_seconds{instance=\"$source\"}))) or (4 * ((uipath_collector_runtimes_status{instance=\"$source\"} == 1) unless on(instance) ((uipath_collector_runtimes_status{instance=\"$source\"} == 1) and on(instance) (time() - uipath_collector_runtimes_last_success_time_seconds{instance=\"$source\"} < on(instance) uipath_collector_freshness_seconds{instance=\"$source\"}))))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Value"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value": "Collection"
            },
            "indexByName": {
              "Value": 0
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "\u2014",
          "custom": {
            "minWidth": 50
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Disabled"
                },
                "1": {
                  "text": "Collected"
                },
                "2": {
                  "text": "Failed",
                  "color": "red"
                },
                "3": {
                  "text": "Forbidden",
                  "color": "red"
                },
                "4": {
                  "text": "Stale",
                  "color": "orange"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "timeFrom": "15m",
      "hideTimeOverride": true
    },
    {
      "id": 3,
      "title": "Latest job snapshot",
      "type": "table",
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 16,
        "h": 4
      },
      "datasource": {
        "type": "elasticsearch",
        "uid": "uipath-logs"
      },
      "targets": [
        {
          "refId": "A",
          "query": "service.node.name:\"$source\" AND uipath.event.kind:\"jobs.snapshot\" AND uipath.snapshot.valid_until:[now TO *]",
          "metrics": [
            {
              "id": "1",
              "type": "raw_data",
              "settings": {
                "size": "1"
              }
            }
          ],
          "bucketAggs": [],
          "timeField": "@timestamp"
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "@timestamp",
                "uipath.snapshot.status",
                "uipath.snapshot.jobs",
                "uipath.snapshot.valid_until"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "@timestamp": "Observed at",
              "uipath.snapshot.status": "Snapshot status",
              "uipath.snapshot.jobs": "Active jobs",
              "uipath.snapshot.valid_until": "Expires at"
            },
            "indexByName": {
              "@timestamp": 0,
              "uipath.snapshot.status": 1,
              "uipath.snapshot.jobs": 2,
              "uipath.snapshot.valid_until": 3
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "Newest observation for this source, including incomplete and empty snapshots. This panel must be present and complete before interpreting empty job tables.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "\u2014",
          "custom": {
            "minWidth": 50
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Snapshot status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "complete": {
                        "text": "Complete",
                        "color": "green"
                      },
                      "incomplete": {
                        "text": "Incomplete",
                        "color": "red"
                      },
                      "capped": {
                        "text": "Capped",
                        "color": "orange"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "timeFrom": "15m",
      "hideTimeOverride": true
    },
    {
      "id": 4,
      "title": "Hosts \u2014 capacity across all folders",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 10,
        "h": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "uipath-metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(uipath_runtime_status{instance=\"$source\",uipath_runtime_type=~\"${runtime:regex}\"} and on(instance,uipath_session_id,uipath_runtime_type) (uipath_runtime_observed_time_seconds{instance=\"$source\",uipath_runtime_type=~\"${runtime:regex}\"} == on(instance) group_left uipath_collector_runtimes_last_success_time_seconds{instance=\"$source\"})) and on(instance) ((uipath_collector_runtimes_status{instance=\"$source\"} == 1) and on(instance) (time() - uipath_collector_runtimes_last_success_time_seconds{instance=\"$source\"} < on(instance) uipath_collector_freshness_seconds{instance=\"$source\"}))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "(uipath_runtime_used{instance=\"$source\",uipath_runtime_type=~\"${runtime:regex}\"} and on(instance,uipath_session_id,uipath_runtime_type) (uipath_runtime_observed_time_seconds{instance=\"$source\",uipath_runtime_type=~\"${runtime:regex}\"} == on(instance) group_left uipath_collector_runtimes_last_success_time_seconds{instance=\"$source\"})) and on(instance) ((uipath_collector_runtimes_status{instance=\"$source\"} == 1) and on(instance) (time() - uipath_collector_runtimes_last_success_time_seconds{instance=\"$source\"} < on(instance) uipath_collector_freshness_seconds{instance=\"$source\"}))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "(uipath_runtime_capacity{instance=\"$source\",uipath_runtime_type=~\"${runtime:regex}\"} and on(instance,uipath_session_id,uipath_runtime_type) (uipath_runtime_observed_time_seconds{instance=\"$source\",uipath_runtime_type=~\"${runtime:regex}\"} == on(instance) group_left uipath_collector_runtimes_last_success_time_seconds{instance=\"$source\"})) and on(instance) ((uipath_collector_runtimes_status{instance=\"$source\"} == 1) and on(instance) (time() - uipath_collector_runtimes_last_success_time_seconds{instance=\"$source\"} < on(instance) uipath_collector_freshness_seconds{instance=\"$source\"}))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "exclude": {
              "names": [
                "__name__"
              ]
            }
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "uipath_host_name",
                "Value #A",
                "Value #B",
                "Value #C",
                "uipath_runtime_type"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "uipath_host_name": "Host",
              "Value #A": "Status",
              "Value #B": "Used",
              "Value #C": "Slots",
              "uipath_runtime_type": "Runtime"
            },
            "indexByName": {
              "uipath_host_name": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "uipath_runtime_type": 4
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "One row per session/runtime type; never summed across folders. Unknown includes stale heartbeat. No current rows means no fresh inventory, not free hosts.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "\u2014",
          "custom": {
            "minWidth": 50
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Unknown / stale",
                        "color": "gray"
                      },
                      "1": {
                        "text": "Free",
                        "color": "green"
                      },
                      "2": {
                        "text": "Partly occupied",
                        "color": "yellow"
                      },
                      "3": {
                        "text": "Occupied",
                        "color": "orange"
                      },
                      "4": {
                        "text": "Maintenance",
                        "color": "purple"
                      },
                      "5": {
                        "text": "Disconnected",
                        "color": "red"
                      },
                      "6": {
                        "text": "Unresponsive",
                        "color": "red"
                      },
                      "7": {
                        "text": "No capacity",
                        "color": "gray"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Host"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 145
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Used"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 50
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Slots"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 50
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Runtime"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          }
        ]
      },
      "timeFrom": "15m",
      "hideTimeOverride": true
    },
    {
      "id": 5,
      "title": "Running / stopping jobs",
      "type": "table",
      "gridPos": {
        "x": 10,
        "y": 8,
        "w": 14,
        "h": 8
      },
      "datasource": {
        "type": "elasticsearch",
        "uid": "uipath-logs"
      },
      "targets": [
        {
          "refId": "A",
          "query": "service.node.name:\"$source\" AND uipath.event.kind:\"jobs.snapshot\" AND uipath.snapshot.valid_until:[now TO *]",
          "metrics": [
            {
              "id": "1",
              "type": "raw_data",
              "settings": {
                "size": "1"
              }
            }
          ],
          "bucketAggs": [],
          "timeField": "@timestamp"
        }
      ],
      "transformations": [
        {
          "id": "filterByValue",
          "options": {
            "type": "include",
            "match": "all",
            "filters": [
              {
                "fieldName": "uipath.snapshot.status",
                "config": {
                  "id": "regex",
                  "options": {
                    "value": "^complete$"
                  }
                }
              }
            ]
          }
        },
        {
          "id": "extractFields",
          "options": {
            "source": "message",
            "format": "json",
            "replace": true
          }
        },
        {
          "id": "reduce",
          "options": {
            "mode": "seriesToRows",
            "reducers": [
              "lastNotNull"
            ]
          }
        },
        {
          "id": "extractFields",
          "options": {
            "source": "Last *",
            "format": "json",
            "replace": true
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "type": "include",
            "match": "all",
            "filters": [
              {
                "fieldName": "state",
                "config": {
                  "id": "regex",
                  "options": {
                    "value": "^(Running|Stopping|Terminating|Resumed)$"
                  }
                }
              },
              {
                "fieldName": "folder_id",
                "config": {
                  "id": "regex",
                  "options": {
                    "value": "^(${folder:regex})$"
                  }
                }
              }
            ]
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "process",
                "host",
                "robot_username",
                "state",
                "elapsed_seconds",
                "folder",
                "priority"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "process": "Process",
              "host": "Host",
              "robot_username": "Account",
              "state": "State",
              "elapsed_seconds": "Elapsed",
              "folder": "Folder",
              "priority": "Priority"
            },
            "indexByName": {
              "process": 0,
              "host": 1,
              "robot_username": 2,
              "state": 3,
              "elapsed_seconds": 4,
              "folder": 5,
              "priority": 6
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "An empty host means the API has not reported an assignment. Elapsed time is sampled and includes suspension; it does not measure consumed runtime. Folder filtering is applied after selecting the source snapshot.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "\u2014",
          "custom": {
            "minWidth": 50
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Elapsed"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Waiting"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Host"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "": {
                        "text": "Unassigned"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Process"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 155
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Host"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 135
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Account"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 95
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Elapsed"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Waiting"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Folder"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 140
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Priority"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 75
              }
            ]
          }
        ]
      },
      "timeFrom": "15m",
      "hideTimeOverride": true
    },
    {
      "id": 6,
      "title": "Pending / suspended jobs",
